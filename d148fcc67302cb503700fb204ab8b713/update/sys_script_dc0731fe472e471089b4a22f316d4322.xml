        <script><![CDATA[(function executeRule(current, previous) {

    var token = gs.generateGUID();

    var expiry = new GlideDateTime();
    expiry.addSeconds(24 * 60 * 60);

    current.u_registration_token = token;
    current.u_token_expiration = expiry;
    current.u_token_used = false;
    current.u_status = 'pending';

    current.update();

