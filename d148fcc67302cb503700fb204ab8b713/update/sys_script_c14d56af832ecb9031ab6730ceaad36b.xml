        <script><![CDATA[(function executeRule(current, previous) {

    if (current.u_trip_request.nil()) return;

    var grFeedback = new GlideRecord('x_travel_buddy_app_travel_trip_feedback');
    grFeedback.addQuery('u_trip_request', current.u_trip_request);
    grFeedback.addQuery('sys_id', '!=', current.sys_id);
    grFeedback.query();

    if (grFeedback.next()) {
        gs.addErrorMessage('Feedback has already been submitted for this Trip Request.');
        current.setAbortAction(true);
    }

})(current, previous);]]></script>
