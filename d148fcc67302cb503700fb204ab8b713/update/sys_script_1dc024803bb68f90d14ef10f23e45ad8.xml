        <script><![CDATA[(function executeRule(current, previous /*null when async*/ ) {


    // 1. Get the exact Start Date the user selected
    var startDateTime = new GlideDateTime(current.start_time);

    //Open the specific Itinerary record they chose so we can read its details
    var itineraryGr = new GlideRecord('x_travel_buddy_app_itinerary_package');

    if (itineraryGr.get(current.u_selected_itinerary)) {

        //Grab the Duration field from that Itinerary record
        var packageDuration = new GlideDuration(itineraryGr.u_duration);

        //Add Itinerary's duration directly to the user's Start Time
        startDateTime.add(packageDuration);

        //push the calculated result into the End Time
        current.setValue('end_time', startDateTime.getValue());
    }

})(current, previous);]]></script>
