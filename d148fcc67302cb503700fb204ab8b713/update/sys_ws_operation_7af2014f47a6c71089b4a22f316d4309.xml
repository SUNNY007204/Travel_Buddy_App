    <sys_ws_operation action="INSERT_OR_UPDATE">
        <active>true</active>
        <consumes>application/json,application/xml,text/xml</consumes>
        <consumes_customized>false</consumes_customized>
        <default_operation_uri/>
        <enforce_acl/>
        <http_method>POST</http_method>
        <name>Update Password</name>
        <operation_script><![CDATA[(function process(request, response) {
    var requestBody = request.body.data;
    var newPassword = requestBody ? requestBody.password : null;
    var userSysId = gs.getUserID();

    if (!newPassword) {
        response.setStatus(400);
        return { success: false, message: "Password is required." };
    }

    var userGr = new GlideRecord('sys_user');
    if (userGr.get(userSysId)) {
        // setDisplayValue automatically hashes the password for sys_user
        userGr.user_password.setDisplayValue(newPassword);
        userGr.update();
        
        return { success: true, message: "Password updated successfully!" };
    }

    response.setStatus(404);
    return { success: false, message: "User record not found." };
})();]]></operation_script>
        <operation_uri>/api/x_travel_buddy_app/password_management_api/update</operation_uri>
