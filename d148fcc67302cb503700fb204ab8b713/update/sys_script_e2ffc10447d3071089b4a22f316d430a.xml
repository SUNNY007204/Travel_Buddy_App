        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

    var destinationName = '';
    if (current.u_destination) {
        destinationName = current.u_destination.getDisplayValue() || current.u_destination.toString();
    }

    if (destinationName) {
        try {
            var utils = new WeatherUtils();
            var weatherResult = utils.getWeatherForDestination(destinationName);

            if (weatherResult) {
                // Since this is an async BR, update the record explicitly
                current.weather = weatherResult.toString();
                current.update();
            }
        } catch (ex) {
            gs.error("Populate Weather Business Rule failed: " + ex.message);
        }
    }

})(current, previous);]]></script>
